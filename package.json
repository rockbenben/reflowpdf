{
  "name": "reflowpdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ReflowPDF — enlarge / reflow a PDF for comfortable phone reading, entirely in the browser (k2pdfopt WASM).",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build:wasm": "bash scripts/build.sh",
    "dev": "vite",
    "build:pages": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "node test/make-fixtures.mjs && node test/engine-check.mjs && node test/hybrid-check.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.1",
    "file-saver": "^2.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
